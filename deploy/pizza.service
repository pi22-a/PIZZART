# 게임 서버를 서비스로 돌린다. /etc/systemd/system/pizza.service 에 둔다.
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pizza
#   sudo systemctl status pizza
#   journalctl -u pizza -f          # 로그 보기
#
# Restart=always 인 이유: 방 상태가 메모리에만 있어서 죽으면 돌던 판이 날아간다.
# 되살아나도 그 판은 못 살리지만, 다음 판은 바로 할 수 있다.

[Unit]
Description=PIZZA 게임 서버
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/PIZZA
Environment=NODE_ENV=production
# 8090을 쓰는 이유는 개발 서버(8080)와 습관을 맞추기 위해서다. 터널만 이 포트를 본다.
Environment=PORT=8090
ExecStart=/usr/bin/node --import tsx src/server/index.ts
Restart=always
RestartSec=3
# 그림 기록이 쌓이는 자리. 없으면 서버가 만들지만 권한은 여기서 확실히 해둔다.
ReadWritePaths=/home/ubuntu/PIZZA/data

# 잠깐의 보안 조임 — 이 프로세스는 자기 폴더 밖을 건드릴 일이 없다
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
